{
  "uid": "platform-overview",
  "title": "Platform overview - all environments",
  "tags": [
    "platform",
    "federation"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-global"
        },
        "query": {
          "query": "label_values(up{job=~\"federate-.+\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{job=~\"federate-.+\"}, env)",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "title": "Targets down",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (env) (up{env=~\"$env\", job!~\"federate-.+\"} == 0) or count by (env) (up{env=~\"$env\", job!~\"federate-.+\"}) * 0",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Federation status",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"federate-.+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} - {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                },
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Firing alerts",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count by (severity) (ALERTS{alertstate=\"firing\", env=~\"$env\", alertname!=\"Watchdog\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{severity}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Federated series per environment",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_samples_scraped{job=~\"federate-.+\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Active alerts",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\", env=~\"$env\", alertname!=\"Watchdog\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Hosts",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "title": "CPU utilisation (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, instance:node_cpu_utilisation:ratio_rate5m{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Memory utilisation (top 10)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, instance:node_memory_utilisation:ratio{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Least free disk space",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(10, instance:node_filesystem_avail:ratio{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.05
              },
              {
                "color": "green",
                "value": 0.15
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Load per core",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, instance:node_load1_per_cpu:ratio{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "row",
      "title": "Databases",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "title": "Replication lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:mysql_replica_lag:seconds{env=~\"$env\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "title": "Connections used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "instance:mysql_connections:ratio{env=~\"$env\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 15,
      "type": "row",
      "title": "Kubernetes & containers",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 16,
      "title": "Pods not ready",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (env, namespace) (namespace_pod:kube_pod_not_ready:count{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{env}} {{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 17,
      "title": "Pod restarts (1h)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 8,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, namespace_pod:kube_pod_container_restarts:increase1h{env=~\"$env\"} > 0)",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{namespace}}/{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "title": "Container memory vs limit",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-global"
      },
      "gridPos": {
        "x": 16,
        "y": 39,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, container:memory_working_set:ratio_limit{env=~\"$env\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-global"
          },
          "legendFormat": "{{instance}} {{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}