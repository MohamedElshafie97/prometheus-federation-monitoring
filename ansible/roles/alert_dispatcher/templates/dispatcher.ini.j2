{{ ansible_managed | comment }}
[server]
# inside the container; published on 127.0.0.1 by docker
listen = 0.0.0.0:9095
log_level = INFO
alertmanager_url = {{ alert_dispatcher_alertmanager_url }}

[spaces]
{% for name, url in alert_dispatcher_spaces.items() %}
{{ name }} = {{ url }}
{% endfor %}

[heartbeat]
space = {{ alert_dispatcher_heartbeat_space }}
max_silence_seconds = {{ alert_dispatcher_max_silence }}
