[server]
listen = 127.0.0.1:9095
log_level = INFO
# Shown as a "Silence / details" link in firing messages
alertmanager_url = http://alertmanager01:9093

[spaces]
# Google Chat incoming webhooks: Space > Apps & integrations > Webhooks.
# The URL contains a key and token - treat it like a password and keep
# this file mode 0640 root:alert-dispatcher.
prod-alerts = https://chat.googleapis.com/v1/spaces/AAAAxxxxxxx/messages?key=REPLACE&token=REPLACE
nonprod-alerts = https://chat.googleapis.com/v1/spaces/AAAAyyyyyyy/messages?key=REPLACE&token=REPLACE

[heartbeat]
# Where to complain if the Watchdog alert stops arriving
space = prod-alerts
max_silence_seconds = 300
